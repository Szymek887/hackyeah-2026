### Demo accounts for the login screen (public, no X-User-Id)
GET {{host}}/api/users/demo
Accept: application/json

> {%
    client.test("Lists seeded accounts ordered by role", function () {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(response.body.length > 0, "Expected seeded users");
        client.assert(response.body[0].role === "REQUESTER", "Requesters come first");
        client.assert(response.body[response.body.length - 1].role === "CITY_ADMIN", "City admin comes last");
    });
%}

### Current user profile (seeded requester "Anna K.")
GET {{host}}/api/users/me
Accept: application/json
X-User-Id: {{requesterId}}

> {%
    client.test("Returns profile of the mocked user", function () {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(response.body.id === 1, "Expected user id 1");
        client.assert(response.body.role !== undefined, "Expected role");
    });
%}

### Replace spoken languages (ISO 639-1 codes, normalized and sorted)
PUT {{host}}/api/users/me/languages
Content-Type: application/json
Accept: application/json
X-User-Id: {{requesterId}}

{
  "languages": ["pl", "UK", "en"]
}

> {%
    client.test("Languages are replaced", function () {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(JSON.stringify(response.body.languages) === JSON.stringify(["en", "pl", "uk"]), "Expected sorted lower-case codes");
    });
%}

### Unknown language code
PUT {{host}}/api/users/me/languages
Content-Type: application/json
Accept: application/json
X-User-Id: {{requesterId}}

{
  "languages": ["pl", "xx"]
}

> {%
    client.test("Unknown code returns 400", function () {
        client.assert(response.status === 400, "Expected status 400");
    });
%}

### Withdraw the special-needs consent (profile switch off) – deletes the consent record and specialNeeds
PUT {{host}}/api/users/me/special-needs-consent
Content-Type: application/json
Accept: application/json
X-User-Id: {{requesterId}}

{
  "consent": false
}

> {%
    client.test("Consent and special needs are deleted", function () {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(response.body.specialNeedsConsent === false, "Expected no consent");
        client.assert(response.body.specialNeedsConsentGrantedAt === null, "Expected no consent date");
        client.assert(response.body.specialNeeds === false, "Expected specialNeeds deleted");
    });
%}

### Give the consent again (profile switch on) – new consent record, specialNeeds stored again
PUT {{host}}/api/users/me/special-needs-consent
Content-Type: application/json
Accept: application/json
X-User-Id: {{requesterId}}

{
  "consent": true
}

> {%
    client.test("Consent is recorded again", function () {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(response.body.specialNeedsConsent === true, "Expected consent");
        client.assert(response.body.specialNeedsConsentGrantedAt !== null, "Expected consent date");
        client.assert(response.body.specialNeeds === true, "Expected specialNeeds stored");
    });
%}

### Volunteers cannot manage special-needs consent
PUT {{host}}/api/users/me/special-needs-consent
Content-Type: application/json
Accept: application/json
X-User-Id: {{volunteerId}}

{
  "consent": true
}

> {%
    client.test("Volunteer gets 403", function () {
        client.assert(response.status === 403, "Expected status 403");
    });
%}

### Missing X-User-Id header
GET {{host}}/api/users/me
Accept: application/json

> {%
    client.test("Missing header returns 401", function () {
        client.assert(response.status === 401, "Expected status 401");
    });
%}

### Unknown user
GET {{host}}/api/users/me
Accept: application/json
X-User-Id: 999999

> {%
    client.test("Unknown user returns 401", function () {
        client.assert(response.status === 401, "Expected status 401");
    });
%}

### CORS preflight from Expo web (browser sends this before a request with X-User-Id)
OPTIONS {{host}}/api/users/me
Origin: http://localhost:8081
Access-Control-Request-Method: GET
Access-Control-Request-Headers: X-User-Id

> {%
    client.test("Expo web origin is allowed", function () {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(response.headers.valueOf("Access-Control-Allow-Origin") === "http://localhost:8081", "Expected allowed origin");
    });
%}
