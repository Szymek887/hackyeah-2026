### Classify: social
POST {{host}}/api/requests/classify
Content-Type: application/json

{
  "title": "Spacer w parku",
  "description": "Jestem samotną emerytką, chętnie poszłabym z kimś na spacer i porozmawiała."
}

### Classify: scam attempt
POST {{host}}/api/requests/classify
Content-Type: application/json

{
  "title": "Pilna pomoc finansowa",
  "description": "Proszę o przelew 500 zł albo kod BLIK, oddam jutro. Pilne!"
}

> {%
    client.test("Scam is flagged", function () {
        client.assert(response.body.riskFlags.includes("SCAM_SUSPECTED"), "Expected SCAM_SUSPECTED");
    });
%}

### Classify: medical emergency
POST {{host}}/api/requests/classify
Content-Type: application/json

{
  "title": "Źle się czuję",
  "description": "Od godziny mam silny ból w klatce piersiowej i jest mi duszno."
}

> {%
    client.test("Emergency is flagged", function () {
        client.assert(response.body.riskFlags.includes("MEDICAL_EMERGENCY"), "Expected MEDICAL_EMERGENCY");
        client.assert(response.body.category === "MEDICINE", "Expected MEDICINE");
        client.assert(response.body.priority === 1, "Expected priority 1");
    });
%}

### Classify: personal data (no digits may leak into tags)
POST {{host}}/api/requests/classify
Content-Type: application/json

{
  "title": "Pomoc z pismem",
  "description": "Pomoże ktoś wypełnić wniosek? Mój PESEL to 45010112345, tel. 600123456."
}

> {%
    client.test("Personal data is flagged", function () {
        client.assert(response.body.riskFlags.includes("PERSONAL_DATA"), "Expected PERSONAL_DATA");
        client.assert(response.body.tags.every(t => !/[0-9]/.test(t)), "Tags must not contain digits");
    });
%}

### Classify: validation error (blank description)
POST {{host}}/api/requests/classify
Content-Type: application/json

{
  "title": "Pomoc",
  "description": ""
}

> {%
    client.test("Blank description is rejected", function () {
        client.assert(response.status === 400, "Expected status 400");
    });
%}

### Format transcript: messy dictation from a senior
POST {{host}}/api/requests/format-transcript
Content-Type: application/json

{
  "transcript": "dzień dobry yyy no bo ja bym chciała żeby ktoś mi kupił chleb i mleko i jeszcze masło we wtorek nie nie we wtorek w środę bo wie pani ja nie wychodzę z domu od kiedy mi kolano wysiadło"
}

> {%
    client.test("Transcript is formatted", function () {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(response.body.title.length > 0 && response.body.title.length <= 120, "Expected a short title");
        client.assert(response.body.description.length > 0, "Expected a description");
    });
%}

### Format transcript: personal data is left out
POST {{host}}/api/requests/format-transcript
Content-Type: application/json

{
  "transcript": "halo potrzebuję pomocy z wypełnieniem wniosku do ZUS mój telefon to 600 123 456 mieszkam na Długiej 5"
}

### Format transcript: validation error (blank transcript)
POST {{host}}/api/requests/format-transcript
Content-Type: application/json

{
  "transcript": " "
}

> {%
    client.test("Blank transcript is rejected", function () {
        client.assert(response.status === 400, "Expected status 400");
    });
%}
