### Classify: critical (demo scenario)
POST {{host}}/api/requests/classify
Content-Type: application/json

{
  "title": "Potrzebuję leków",
  "description": "Skończyły mi się leki na serce, nie mam jak wyjść z domu. Recepta jest w aplikacji."
}

> {%
    client.test("Critical request gets priority 1", function () {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(response.body.category === "MEDICINE", "Expected MEDICINE");
        client.assert(response.body.priority === 1, "Expected priority 1");
    });
%}

### Classify: groceries
POST {{host}}/api/requests/classify
Content-Type: application/json

{
  "title": "Zakupy",
  "description": "Potrzebuję chleba, mleka i warzyw ze sklepu, mogę oddać pieniądze przy odbiorze."
}

> {%
    client.test("Shopping is GROCERIES", function () {
        client.assert(response.body.category === "GROCERIES", "Expected GROCERIES");
    });
%}

