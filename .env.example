# Copy to .env (git-ignored) next to docker-compose.yml.
POSTGRES_PASSWORD=change-me
# OpenRouter key from https://openrouter.ai/keys; empty = keyword fallback only.
OPENROUTER_API_KEY=
# Public port of nginx (web app + /api proxy).
WEB_PORT=80
# Optional:
# AI_ENABLED=true
# API_PORT=8080
# WEB_API_URL=            # empty = web app calls /api on its own origin
# CORS_ALLOWED_ORIGIN_PATTERNS=https://example.com
